<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>دورة Front End Developer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="icon" href="images/coding logo.png">
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navbar -->

    <nav class="navbar">

        <div class="logo">
            <span>&lt;</span>
        Coding with MO 
            <span>/&gt;</span>
        </div>

        <a href="/login" class="nav-btn">
           تسجيل الدخول
        </a>

    </nav>


    <!-- Hero -->

    <section class="hero">

        <div class="hero-content">

            <div class="hero-text">

                <div class="badge">
                    🚀 دورة مجانية بالكامل
               
                </div>
              
               
                <h1>
                    ابدأ رحلتك في عالم
                    <span>Front End Development</span>
                </h1>

                <p>
                    دورة مجانية تأخذك من الصفر وحتى المستويات المتقدمة
                    في تطوير واجهات المواقع، بأسلوب بسيط وعملي،
                    مع تطبيقات ومشاريع حقيقية.
                </p>

                <div class="buttons">

                    <a href="#register" class="primary-btn">
                        🚀 سجل الآن
                    </a>

                    <a href="#course" class="secondary-btn">
                        اكتشف الدورة
                    </a>

                </div>

                <div class="stats">

                    <div>
                        <strong>100%</strong>
                        <span>مجانية</span>
                    </div>

                    <div>
                        <strong >∞ → 0</strong>
                        <span>من الصفر للاحتراف</span>
                    </div>

                    <div>
                        <strong>مشاريع</strong>
                        <span>عملية حقيقية</span>
                    </div>

                </div>

            </div>


            <!-- Teacher -->

            <div class="teacher">

                <div class="teacher-card">

                    <!-- ضع صورتك هنا -->

                    <div class="teacher-image">
                        <img src="images/coding logo.png" alt="المدرب">
                        
                    </div>

                    <h2>
                       ابدأ رحلتك
                    </h2>

                    <h3>
                        Front End Development
                    </h3>

                    <p>
                      تعلم البرمجة وبناء مواقع
                        احترافية خطوة بخطوة.
                    </p>

                   
                <div class="badge totalStudents">
                   عدد المشتركين في الدوره <span style="color: red;"><%=totalStudents%></span> 
                
                </div>
                </div>

            </div>

        </div>

    </section>


    <!-- Course -->

    <section class="course" id="course">

        <div class="section-title">

            <span>ماذا ستتعلم؟</span>

            <h2>
                من الصفر إلى بناء مشاريع حقيقية
            </h2>

            <p>
                سنبدأ معك خطوة بخطوة حتى تصل إلى مستوى متقدم.
            </p>

        </div>


        <div class="course-grid">

            <div class="course-card">

                <div class="icon">
                    🌐
                </div>

                <h3>
                    HTML
                </h3>

                <p>
                    تعلم بناء هيكل صفحات الويب
                    بطريقة صحيحة واحترافية.
                </p>

            </div>


            <div class="course-card">

                <div class="icon">
                    🎨
                </div>

                <h3>
                    CSS
                </h3>

                <p>
                    تعلم تصميم المواقع وتنسيقها
                    وجعلها متجاوبة مع جميع الأجهزة.
                </p>

            </div>


            <div class="course-card">

                <div class="icon">
                    ⚡
                </div>

                <h3>
                    JavaScript
                </h3>

                <p>
                    تعلم البرمجة وإضافة التفاعل
                    والحركة إلى صفحات الويب.
                </p>

            </div>


            <div class="course-card">

                <div class="icon">
                    🚀
                </div>

                <h3>
                    مشاريع عملية
                </h3>

                <p>
                    طبق ما تعلمته من خلال مشاريع
                    عملية تشبه المشاريع الحقيقية.
                </p>

            </div>

        </div>

    </section>

<section class="about" id="about">

    <div class="about-image">
        <img src="images/Mohammed Al-Issa.png" alt="صورة المدرب">
    </div>

    <div class="about-content">

        <span class="section-tag">من أنا؟</span>

        <h2>خلّيني أعرّفك <span>عليّ</span> 👋</h2>

        <p>
            أنا محمد، مهتم بتطوير الويب وتعليم البرمجة بطريقة بسيطة
            وعملية، وأؤمن أن تعلم البرمجة لا يحتاج إلى تعقيد،
            بل يحتاج إلى شرح واضح وتطبيق مستمر.
        </p>

        <p>
            أشارك من خلال هذه المنصة رحلتي في تعلم وتطوير مهارات
            الويب، وأساعد الطلاب على فهم البرمجة خطوة بخطوة،
            بدايةً من HTML و CSS و JavaScript، وصولاً إلى
            تطوير تطبيقات ويب متكاملة.
        </p>

        <p>
            هدفي ليس فقط أن تتعلم كتابة الكود، بل أن تفهم
            <strong>كيف تفكر كمبرمج</strong> وكيف تبني مشاريع
            حقيقية تستطيع أن تفتخر بها. 🚀
        </p>

        <div class="about-stats">

            <div>
                <strong>HTML</strong>
                <span>أساس الويب</span>
            </div>

            <div>
                <strong>CSS</strong>
                <span>تصميم الواجهات</span>
            </div>

            <div>
                <strong>JS</strong>
                <span>برمجة الويب</span>
            </div>

            <div>
                <strong>Node.js</strong>
                <span>Backend</span>
            </div>

        </div>

    </div>

</section>
    <!-- =====================
     STUDENTS REVIEWS
===================== -->

<section class="reviews" id="reviews">

    <div class="section-title">

        <span>⭐ آراء الطلاب</span>

        <h2>
            ماذا قال طلابنا عن الدورة؟
        </h2>

        <p>
            تجارب وآراء الطلاب الذين بدأوا رحلتهم في تعلم البرمجة معنا.
        </p>

    </div>

   
<div id="carouselExampleAutoplaying" class="carousel slide w-50 mx-auto mb-5" data-bs-ride="carousel">
  <div class="carousel-inner">
    <!-- Review 1 -->
 <%if(arrayOfreviews.length > 0){%>
       <% arrayOfreviews.forEach(review =>{%>
        <div class="review-card carousel-item active">

            <div class="review-header ">

              

                <div>

                    <h3 class="mx-5">
                       <%=review.name%>
                       
                    </h3>

                   

                </div>

            </div>


            <div class="stars mx-5">
                <%="⭐".repeat(review.rating)%>
            </div>


            <p class="review-text mx-5">
             <%=review.comment%>
            </p>


            <div class="quote">
                “
            </div>

        </div>
        <%})%>
    <%}%>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
    

    <div class="reviews-container">


        


       


        


    </div>

</section>

    <!-- Register -->

    <section class="register" id="register">

        <div class="register-container">

            <div class="register-text">

                <span>
                    🎓 ابدأ الآن
                </span>

                <h2>
                    مستعد تبدأ رحلتك؟
                </h2>

                <p>
                    إذا لم تكن مسجلًا معنا، أنشئ حسابك الآن
                    وانضم إلى الدورة المجانية.
                </p>

            </div>


            <form id="registerForm" method="post" action="/signup">

    <!-- الاسم -->
    <div class="input-group">

        <label for="name">
            الاسم الكامل
        </label>

        <input
            type="text"
            id="name"
            name="name"
            placeholder="أدخل اسمك الكامل"
            required
        >

    </div>


    <!-- البريد الإلكتروني -->
    <div class="input-group">

        <label for="email">
            البريد الإلكتروني
        </label>
<span style="color: red;"><%=wrong%></span>
        <input
            type="email"
            id="email"
            name="email"
            placeholder="example@email.com"
            required
        >

    </div>


    <!-- البلد -->
    <div class="input-group">

        <label for="country">
            البلد
        </label>

        <select id="country" name="country" required>

            <option value="" disabled selected>
                اختر بلدك
            </option>

            <option value="iraq">العراق</option>
            <option value="egypt">مصر</option>
            <option value="syria">سوريا</option>
            <option value="saudi-arabia">السعودية</option>
            <option value="uae">الإمارات</option>
            <option value="qatar">قطر</option>
            <option value="kuwait">الكويت</option>
            <option value="bahrain">البحرين</option>
            <option value="oman">عُمان</option>
            <option value="jordan">الأردن</option>
            <option value="algeria">الجزائر</option>
            <option value="morocco">المغرب</option>
            <option value="tunisia">تونس</option>
            <option value="libya">ليبيا</option>
            <option value="lebanon">لبنان</option>
            <option value="palestine">فلسطين</option>

            <option value="other">
                دولة أخرى
            </option>

        </select>

    </div>


    <!-- الجنس -->
    <div class="input-group">

        <label for="gender">
            الجنس
        </label>

        <select id="gender" name="gender" required>

            <option value="" disabled selected>
                اختر الجنس
            </option>

            <option value="ذكر">
                ذكر
            </option>

            <option value="انثى">
                أنثى
            </option>

        </select>

    </div>

    <!-- معرفه في مجال البرمجه -->
    <div class="input-group">

       <label for="programmingLevel">
    هل لديك فكرة مسبقة عن الـ Front-End Development؟
        </label>

        <select id="programmingLevel" name="programmingLevel" required>

    <option value="" disabled selected>
        اختر مستوى معرفتك بالبرمجة
    </option>

    <option value="good">
        نعم، عندي فكرة جيدة
    </option>

    <option value="basic">
        نعم، عندي فكرة بسيطة
    </option>

    <option value="none">
        لا، لا توجد عندي أي فكرة نهائيًا
    </option>

</select>

    </div>

    <!-- WhatsApp -->
    <div class="input-group">

        <label for="whatsapp">
            رقم WhatsApp
        </label>

        <input
            type="tel"
            id="whatsapp"
            name="whatsapp"
            placeholder="+31 6 12345678"
            required
        >

        <small>
            يرجى إدخال رقم WhatsApp مع مفتاح الدولة
        </small>

    </div>


    <!-- كلمة المرور -->
    <div class="input-group">

        <label for="password">
            كلمة المرور
        </label>

        <input
            type="password"
            id="password"
            name="password"
            placeholder="أدخل كلمة المرور"
            required
        >

    </div>


    <!-- إنشاء الحساب -->
    <button type="submit">
        إنشاء حساب 🚀
    </button>


    <!-- تسجيل الدخول -->
    <p class="login-text">

        لديك حساب بالفعل؟

        <a href="/login">
            تسجيل الدخول
        </a>

    </p>

</form>

        </div>

    </section>


    <% if (wrong) { %>

    

    <script>
        document.getElementById("registerForm").scrollIntoView({
            behavior: "smooth"
        })
    </script>

<% } %>

    <!-- Footer -->

    <footer>

        <p>
            © 2026 جميع الحقوق محفوظة
        </p>

        <p>
            Front End Developer Course
        </p>

    </footer>


    <script src="script.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>

</html>