<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>لوحة الإدارة | Coding with MO</title>

    <link
        rel="stylesheet"
        href="admin-dashboard.css"
    >

</head>


<body>


    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div class="logo">

            <span>&lt;/&gt;</span>

            Coding with MO

        </div>


        <nav>

            <a href="/admin-dashboard" class="active">
                🏠
                لوحة التحكم
            </a>

            <a href="/admin-students">
                👨‍🎓
                الطلاب
            </a>

            <a href="/admin-tasks">
                📝
               اضافه مهمه
            </a>

            <a href="/admin-submissions">
                📚
               المهام المسلمه
            </a>

          

            <a href="/admin-attendance">
                📊
                الحضور
            </a>

          

        </nav>


        <a href="#" class="logout">

            🚪
            تسجيل الخروج

        </a>

    </aside>



    <!-- =========================
         MAIN
    ========================== -->

    <main class="main">


        <!-- HEADER -->

        <header class="top">

            <div>

                <h1>
                    لوحة الإدارة 👋
                </h1>

                <p>
                    أهلاً محمد، إليك ملخص المنصة اليوم.
                </p>

            </div>


            <div class="admin-profile">

                <div class="admin-avatar">
                    MO
                </div>

                <div>

                    <strong>
                        محمد
                    </strong>

                    <span>
                        Administrator
                    </span>

                </div>

            </div>

        </header>



        <!-- =========================
             STATISTICS
        ========================== -->

        <section class="stats">


            <div class="stat-card">

                <div class="stat-icon">
                    👨‍🎓
                </div>

                <div>

                    <span>
                        إجمالي الطلاب
                    </span>

                    <strong>
                     <%=totalStudents.length%>
                    </strong>

                  

                </div>

            </div>


           


        </section>



        <!-- =========================
             QUICK ACTIONS
        ========================== -->

        <section class="quick-actions">

            <button>
                <a class="a-tag" href="/admin-students">➕ تعديل بيانات طالب</a>
            </button>

          

            <button>
                <a class="a-tag" href="/admin-tasks">📝 إضافة مهمة</a>
            </button>

            <button>
                <a class="a-tag" href="/admin-submissions">📚 المهام المسلمه</a>    
            </button>
          
            <button>
                
                                <a class="a-tag" href="/admin-attendance">📊 تسجيل حضور</a>    

            </button>

        </section>



        <!-- =========================
             STUDENTS
        ========================== -->

        <section class="card">


            <div class="card-header">

                <div>

                    <h2>
                        الطلاب 👨‍🎓
                    </h2>

                    <p>
                        إدارة ومتابعة الطلاب المسجلين
                    </p>

                </div>


                <div class="header-actions">

                   <form action="/admin-dashboard" method="post">
                     <input
                        name="emailOrNameOfStudent"
                        type="search"
                        placeholder="ابحث عن طالب..."
                    >
                   </form>
<form action="/admin-dashboard" method="post">
                      <button type="submit">
                        عرض الكل
                    </button>
                   </form>


                   

                </div>

            </div>



            <div class="table-container">

                <table>

                    <thead>

                        <tr>

                            <th>
                                الطالب
                            </th>

                            <th>
                                البلد
                            </th>

                            <th>
                                الدورة
                            </th>

                            <th>
                                الحضور
                            </th>

                            <th>
                                المستوى
                            </th>

                            <th>
                                الحالة
                            </th>

                            <th>
                                إجراء
                            </th>

                        </tr>

                    </thead>


                    <tbody>

<%if(searchValue){%>
   <% searchValue.forEach(student=>{%>
 <tr>

                            <td>

                                <div class="student">

                                    <img
                                        src="images/student1.jpg"
                                        alt="الطالب"
                                    >

                                    <div>

                                        <strong>
                                           <%=student.name%>
                                        </strong>

                                        <span>
                                                                                      <%=student.email%>

                                        </span>

                                    </div>

                                </div>

                            </td>


                            <td>
                          <%=student.country%>

                            </td>


                            <td>
                                HTML & CSS & JS
                            </td>


                            <td>

                                <span class="good">
                                    92%
                                </span>

                            </td>


                            <td>

                                <span class="level good">
                                    ممتاز
                                </span>

                            </td>


                            <td>

                                <span class="status active">
                                    نشط
                                </span>

                            </td>


                            <td>

                               <form action="/edit-student" method="post">
                                         <button type="submit" class="view-btn">
                                              عرض
                                           </button>
                                           <input type="hidden" name="id" value="<%=student._id%>">
                                    </form>

                            </td>

                        </tr>
    <%})%>
<%} else {%>
<%totalStudents.forEach(student =>{%>
<tr>

                            <td>

                                <div class="student">

                                    <img
                                        src="images/student1.jpg"
                                        alt="الطالب"
                                    >

                                    <div>

                                        <strong>
                                           <%=student.name%>
                                        </strong>

                                        <span>
                                                                                      <%=student.email%>

                                        </span>

                                    </div>

                                </div>

                            </td>


                            <td>
                          <%=student.country%>

                            </td>


                            <td>
                                HTML & CSS & JS
                            </td>


                            <td>

                                <span class="good">
                                    
                                </span>

                            </td>


                            <td>

                                <span class="level good">
                                   
                                </span>

                            </td>


                            <td>

                                <span class="status active">
                                    N.V.T.
                                </span>

                            </td>


                            <td>
                                    <form action="/edit-student" method="post">
                                         <button type="submit" class="view-btn">
                                              عرض
                                           </button>
                                           <input type="hidden" name="id" value="<%=student._id%>">
                                    </form>
                                

                            </td>

                        </tr>
<%})%>

<%}%>
                       





                    </tbody>

                </table>

            </div>

        </section>



    





     


    </main>


</body>

</html>