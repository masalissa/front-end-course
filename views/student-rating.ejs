<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>تقييم الدورة</title>

    <link rel="stylesheet" href="student-rating.css">
    <link rel="stylesheet" href="student-dashboard.css">
</head>

<body>
 <aside class="sidebar">

        <div class="logo">
             <img width="100px" src="images/coding logo.png" alt="">
            
           <h4> Coding with MO</h4>
        </div>

        <nav>

            <a href="/student-dashboard">🏠 لوحة التحكم</a>
            <a href="/student-tasks">📝 المهام</a>
            <a href="/student-attendance">📊 الحضور</a>
            <a href="/student-rating" class="active">🌟 تقييم الدورة</a>
        </nav>

        <a href="/logout" class="logout">
            🚪 تسجيل الخروج
        </a>

    </aside>
    <main class="main">

        <div class="rating-container">

            <div class="rating-header">
                <div class="logo" style="display: flex; justify-content: center; align-items: center; gap: 5px ; ">
                    <span><img style="width: 50px;" src="images/coding logo.png" alt="coding logo"></span>
                    Coding with MO
                </div>

                <h1>تقييم الدورة</h1>

                <p>
                    نود معرفة رأيك عن الدورة وتجربتك معنا
                </p>
            </div>
            <%if(wrong){%>
                <h3 style="margin-bottom:10px; background-color:rgba(255, 0, 0, 0.801); color:yellow; text-align: center; padding:10px; border-radius: 5px;">لقد قدمت تقييمك مسبقاً شكرا على التقييم 🚧</h3>
            <%}%>
           
            <form class="rating-form" action="/student-rating" method="POST">

                <div class="input-group">

                    <label>اسم الطالب</label>

                    <input readonly
                        name="studentName"
                        type="text"
                        placeholder=""
                        value="<%=studentobj.name%>"
                    >

                </div>
             

                <div class="input-group">

                    <label>كم تعطي الدورة من 5؟</label>

                    <select required name="rating">
                        <option value="">اختر التقييم</option>
        
                        <option value="5">⭐⭐⭐⭐⭐ 5 / 5</option>
                        <option value="4">⭐⭐⭐⭐ 4 / 5</option>
                        <option value="3">⭐⭐⭐ 3 / 5</option>
                        <option value="2">⭐⭐ 2 / 5</option>
                        <option value="1">⭐ 1 / 5</option>
                    </select>

                </div>


                <div class="input-group">

                    <label>تعليقك</label>

                    <textarea required
                        name="comment"
                        rows="6"
                        placeholder="اكتب رأيك عن الدورة..."
                    ></textarea>

                </div>


                <button id="submitBTN"
                    type="submit"
                    class="submit-btn"
                >
                    إرسال التقييم
                </button>
               

            </form>
                <button id="btnSubmit" class="submit-btn">
                 رجوع
                </button>
        </div>

    </main>

    <script>
        let btn = document.getElementById("btnSubmit")
        let submitBTN = document.getElementById("submitBTN")
        submitBTN.addEventListener("click",()=>{
            alert("🌟 شكرا على تقيمك للدوره تقييمك يساعدنا على تطوير الدوره بشكل دوري")
        })
        btn.addEventListener("click",()=>{
window.location.href = "/student-dashboard"
        })
    </script>
</body>
</html>